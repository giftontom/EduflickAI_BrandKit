{
  // Worker "apply" — serves ./public via Static Assets + captures applications in KV.
  // This OVERWRITES the existing auto-generated "apply" script (currently a broken
  // redirect loop). It reuses the same script name, so the routes below are preserved.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apply",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-20",
  "compatibility_flags": ["nodejs_compat"],

  // Static Assets: serve the registration site from ./public.
  // The Worker runs FIRST for every request (run_worker_first: true) and authors
  // all routing itself — it serves pages via the ASSETS binding and redirects the
  // bare root. html_handling is "none" because the Worker maps pretty URLs to
  // files explicitly; unmatched paths fall back to 404.html.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  // Durable store for submissions. Create with:
  //   wrangler kv namespace create APPLICATIONS
  // then paste the printed id below.
  "kv_namespaces": [
    { "binding": "APPLICATIONS", "id": "e50b343a745d4081940f36eeefb71cc0" }
  ],

  // Path-based routes — EXACTLY the two that already exist for script "apply".
  // The deploy token lacks Workers Routes Edit, so wrangler can't change routes;
  // keeping them identical means no route change is attempted and the existing
  // "eduflickai.com/*" route (which catches every path) serves the new code.
  "routes": [
    { "pattern": "eduflickai.com/apply", "zone_name": "eduflickai.com" },
    { "pattern": "eduflickai.com/*", "zone_name": "eduflickai.com" }
  ],

  "observability": { "enabled": true },

  // Public (non-secret) vars. META_PIXEL_ID turns the Meta Pixel + Conversions API ON;
  // leave "" to keep ad tracking OFF (no Pixel, no cookies, CAPI no-ops). It must match
  // <meta name="meta-pixel-id"> in public/apply/*.html. NOTE: named environments below
  // do NOT inherit top-level vars — repeat META_PIXEL_ID in each env that needs it.
  "vars": {
    "META_PIXEL_ID": ""
  },

  // Spam protection is HONEYPOT-ONLY for now (no Turnstile widget yet). To enable
  // Turnstile later: set meta[name=turnstile-sitekey] in public/apply/index.html,
  // run `wrangler secret put TURNSTILE_SECRET_KEY`, and add this back so a missing
  // secret fails closed instead of silently disabling protection:
  //   "vars": { "REQUIRE_TURNSTILE": "true" },

  // Preview target: `wrangler deploy --env staging` publishes to
  // apply-staging.<your-subdomain>.workers.dev with NO production routes, so you
  // can verify everything before promoting to eduflickai.com.
  "env": {
    "staging": {
      "name": "apply-staging",
      "workers_dev": true,
      "vars": {
        "META_PIXEL_ID": ""
      },
      "kv_namespaces": [
        { "binding": "APPLICATIONS", "id": "c57e85b397634c6dbac77664c721e136" }
      ]
    }
  }

  // Secrets (NOT in this file — set with `wrangler secret put <NAME>`):
  //   TURNSTILE_SECRET_KEY   — Turnstile server secret (required in production)
  //   NOTIFY_WEBHOOK_URL     — optional Slack/Discord/Apps-Script webhook
  //   META_CAPI_TOKEN        — Meta Conversions API access token (enables server Lead)
  //   META_TEST_EVENT_CODE   — optional; Events Manager "Test events" code for staging
}
