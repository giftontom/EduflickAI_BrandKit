{
  "name": "eduflick-launch-grid-exporter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pixel-perfect PNG exporter for the Eduflick AI launch grid (posts + carousel slides).",
  "scripts": {
    "export": "node export-images.mjs",
    "export:pdf": "node export-pdf.mjs",
    "export:slides": "node export-slides.mjs",
    "export:posters": "node export-posters.mjs",
    "export:stories": "node export-stories.mjs",
    "export:ig": "node export-ig.mjs",
    "gen:backdrops": "node --env-file-if-exists=../.env.local gen-backdrops.mjs",
    "gen:backdrops:proc": "node gen-backdrops-proc.mjs",
    "gen:recraft": "PROVIDER=recraft node --env-file-if-exists=../.env.local gen-backdrops.mjs",
    "gen:gemini": "PROVIDER=gemini node --env-file-if-exists=../.env.local gen-backdrops.mjs",
    "recraft:style": "node --env-file-if-exists=../.env.local recraft-create-style.mjs",
    "gen:vector": "node --env-file-if-exists=../.env.local gen-vector.mjs",
    "gen:ig-backdrops": "node gen-ig-backdrops.mjs",
    "fetch:stock": "node fetch-stock.mjs",
    "treat:stock": "node treat-stock.mjs",
    "treat:image": "node treat-image.mjs",
    "export:avatar": "node export-pf-avatar.mjs",
    "serve": "node serve.mjs",
    "tokens": "node build-tokens.mjs",
    "snippets": "node build-snippets.mjs",
    "check:facts": "node check-facts.mjs",
    "postinstall": "playwright install chromium"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {
    "playwright": "^1.48.0",
    "style-dictionary": "^4.4.0"
  }
}
